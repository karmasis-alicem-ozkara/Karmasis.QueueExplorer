<Window x:Class="KarmasisQueueExplorer.App.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:behaviors="clr-namespace:KarmasisQueueExplorer.App.Behaviors"
         xmlns:vm="clr-namespace:KarmasisQueueExplorer.App.ViewModels"
         mc:Ignorable="d"
         Title="Karmasis Queue Explorer"
         Height="720"
         Width="1180"
         MinHeight="560"
         MinWidth="900"
         Background="{StaticResource BackgroundBrush}"
         Foreground="{StaticResource ForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0">
                <TextBlock Text="KarmasisQueueExplorer" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                <Button DockPanel.Dock="Right"
                        Width="92"
                        Height="30"
                        Margin="8,0,0,0"
                        Command="{Binding LoadLocalQueuesCommand}"
                        Content="Refresh" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Local MSMQ Queues" Margin="14" FontSize="14" FontWeight="SemiBold" />
                    <Border DockPanel.Dock="Top"
                            Margin="14,0,14,10"
                            Padding="10"
                            Background="#FF3F2D13"
                            BorderBrush="#FFF59E0B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" Foreground="#FFFDE68A" />
                    </Border>
                    <TreeView ItemsSource="{Binding QueueGroups}"
                              behaviors:TreeViewSelectionBehavior.SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}"
                              Background="{StaticResource PanelBrush}"
                              BorderThickness="0"
                              Foreground="{StaticResource ForegroundBrush}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:QueueGroupViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▾" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:QueueNodeViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="•" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DisplayName}" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Messages" Margin="14" FontSize="14" FontWeight="SemiBold" />
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding SelectedQueue.Name, TargetNullValue=No queue selected}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="{Binding SelectedQueue.Path, TargetNullValue=Select a queue from the left tree to inspect it.}" Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="Message listing starts in Phase 2." Foreground="{StaticResource MutedForegroundBrush}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

                <Border Grid.Row="2" Margin="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Message Detail" Margin="14" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Select a message to view XML, JSON, Text, and Hex body formats in Phase 2."
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2" Background="{StaticResource PanelBrush}" Foreground="{StaticResource MutedForegroundBrush}">
            <StatusBarItem Content="{Binding StatusMessage}" />
            <Separator />
            <StatusBarItem Content="{Binding SelectedQueue.Path, TargetNullValue=No queue selected}" />
        </StatusBar>
    </Grid>
</Window>
