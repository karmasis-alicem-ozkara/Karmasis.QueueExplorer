<Window x:Class="KarmasisQueueExplorer.App.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:behaviors="clr-namespace:KarmasisQueueExplorer.App.Behaviors"
         xmlns:vm="clr-namespace:KarmasisQueueExplorer.App.ViewModels"
         mc:Ignorable="d"
         Title="Karmasis Queue Explorer"
         Height="720"
         Width="1180"
         MinHeight="560"
         MinWidth="900"
         Background="{StaticResource BackgroundBrush}"
         Foreground="{StaticResource ForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0">
                <TextBlock Text="KarmasisQueueExplorer" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" />

                <!-- Machine textbox -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Machine" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,8,0" />
                    <TextBox Width="150"
                             Height="28"
                             Text="{Binding TargetMachineName, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelAltBrush}"
                             Foreground="{StaticResource ForegroundBrush}"
                             BorderBrush="{StaticResource BorderBrush}" />
                </StackPanel>

                <!-- Connection profile management -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Profile" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,8,0" />
                    <ComboBox Width="160"
                              Height="28"
                              ItemsSource="{Binding SavedProfiles}"
                              SelectedItem="{Binding SelectedSavedProfile, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding IsNotBusy}"
                              ToolTip="Select a saved profile to connect immediately. Save/Remove manage the list."
                              Background="{StaticResource PanelAltBrush}"
                              Foreground="{StaticResource ForegroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}" />
                    <TextBox Width="120"
                             Height="28"
                             Margin="6,0,0,0"
                             Text="{Binding NewProfileDisplayName, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelAltBrush}"
                             Foreground="{StaticResource ForegroundBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             ToolTip="Profile display name (leave empty to use machine name)" />
                    <Button Width="54"
                            Height="28"
                            Margin="4,0,0,0"
                            Command="{Binding SaveCurrentProfileCommand}"
                            Content="Save"
                            ToolTip="Save current machine as a connection profile" />
                    <Button Width="60"
                            Height="28"
                            Margin="4,0,0,0"
                            Command="{Binding RemoveSelectedProfileCommand}"
                            Content="Remove"
                            ToolTip="Remove the selected connection profile" />
                </StackPanel>

                <!-- Auto-refresh controls -->
                <CheckBox DockPanel.Dock="Right"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsAutoRefreshEnabled}"
                          Content="Auto refresh" />
                <ComboBox DockPanel.Dock="Right"
                          Width="70"
                          Height="28"
                          Margin="8,0,0,0"
                          ItemsSource="{Binding AutoRefreshIntervalOptions}"
                          SelectedItem="{Binding AutoRefreshIntervalSeconds, Mode=TwoWay}"
                          Background="{StaticResource PanelAltBrush}"
                          Foreground="{StaticResource ForegroundBrush}" />

                <!-- Action buttons -->
                <Button DockPanel.Dock="Right"
                        Width="92"
                        Height="30"
                        Margin="8,0,0,0"
                        Command="{Binding LoadLocalQueuesCommand}"
                        Content="Queues" />
                <Button DockPanel.Dock="Right"
                        Width="98"
                        Height="30"
                        Margin="8,0,0,0"
                        Command="{Binding RefreshMessagesCommand}"
                        Content="Messages" />
                <Button DockPanel.Dock="Right"
                        Width="86"
                        Height="30"
                        Margin="8,0,0,0"
                        Command="{Binding PurgeSelectedQueueCommand}"
                        Content="Purge" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Local MSMQ Queues" Margin="14" FontSize="14" FontWeight="SemiBold" />
                    <Border DockPanel.Dock="Top"
                            Margin="14,0,14,10"
                            Padding="10"
                            Background="#FF3F2D13"
                            BorderBrush="#FFF59E0B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" Foreground="#FFFDE68A" />
                    </Border>
                    <TreeView ItemsSource="{Binding QueueGroups}"
                              behaviors:TreeViewSelectionBehavior.SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}"
                              Background="{StaticResource PanelBrush}"
                              BorderThickness="0"
                              Foreground="{StaticResource ForegroundBrush}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:QueueGroupViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▾" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:QueueNodeViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="•" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DisplayName}" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Messages" FontSize="14" FontWeight="SemiBold" />
                            <TextBox Grid.Column="1"
                                     Margin="12,0"
                                     Height="26"
                                     Text="{Binding MessageFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource PanelAltBrush}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" />
                            <TextBlock Grid.Column="2"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       Text="{Binding LastMessageRefreshTime, StringFormat=Last refresh: {0:T}, TargetNullValue=Not refreshed}" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding FilteredMessages}"
                                  SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Margin="12,0,12,12"
                                  Background="{StaticResource PanelBrush}"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="160" />
                                <DataGridTextColumn Header="Body Preview" Binding="{Binding BodyPreview}" Width="*" />
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="220" />
                                <DataGridTextColumn Header="Sent" Binding="{Binding SentTime}" Width="140" />
                                <DataGridTextColumn Header="Size" Binding="{Binding BodySize}" Width="80" />
                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Margin="18" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding SelectedQueue.Name, TargetNullValue=No queue selected}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="{Binding SelectedQueue.Path, TargetNullValue=Select a queue from the left tree to inspect it.}" Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="Incoming messages appear automatically while auto-refresh is enabled." Foreground="{StaticResource MutedForegroundBrush}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

                <Border Grid.Row="2" Margin="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Message Detail" FontSize="14" FontWeight="SemiBold" />
                            <TextBox Grid.Column="1"
                                     Height="26"
                                     Margin="8,0"
                                     Text="{Binding NewMessageLabel, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource PanelAltBrush}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" />
                            <Button Grid.Column="2"
                                    Width="92"
                                    Height="26"
                                    Command="{Binding SendMessageCommand}"
                                    Content="Send Test" />
                            <Button Grid.Column="2"
                                    Width="92"
                                    Height="26"
                                    Margin="100,0,0,0"
                                    Command="{Binding ExportSelectedMessageCommand}"
                                    Content="Export" />
                            <Button Grid.Column="2"
                                    Width="92"
                                    Height="26"
                                    Margin="200,0,0,0"
                                    Command="{Binding DeleteSelectedMessageCommand}"
                                    Content="Delete" />
                            <TextBox Grid.Column="1"
                                     Height="26"
                                     Margin="8,30,0,0"
                                     Text="{Binding TargetQueuePath, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource PanelAltBrush}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" />
                            <Button Grid.Column="2"
                                    Width="92"
                                    Height="26"
                                    Margin="0,30,0,0"
                                    Command="{Binding CopySelectedMessageCommand}"
                                    Content="Copy" />
                            <Button Grid.Column="2"
                                    Width="92"
                                    Height="26"
                                    Margin="100,30,0,0"
                                    Command="{Binding MoveSelectedMessageCommand}"
                                    Content="Move" />
                        </Grid>
                        <Grid Margin="12,0,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Label: " Foreground="{StaticResource MutedForegroundBrush}" />
                                <TextBlock Text="{Binding SelectedMessage.Label, TargetNullValue=No message selected}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBox Grid.Row="1"
                                     Height="52"
                                     Margin="0,0,0,8"
                                     Text="{Binding NewMessageBody, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     Background="{StaticResource PanelAltBrush}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" />
                            <TabControl Grid.Row="2" Background="{StaticResource PanelBrush}" Foreground="{StaticResource ForegroundBrush}">
                                <TabItem Header="Text">
                                    <TextBox Text="{Binding SelectedBodyText, TargetNullValue=Select a message to read its body.}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" />
                                </TabItem>
                                <TabItem Header="JSON">
                                    <TextBox Text="{Binding SelectedBodyJson}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" />
                                </TabItem>
                                <TabItem Header="XML">
                                    <TextBox Text="{Binding SelectedBodyXml}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" />
                                </TabItem>
                                <TabItem Header="Hex">
                                    <TextBox Text="{Binding SelectedBodyHex}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" />
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2" Background="{StaticResource PanelBrush}" Foreground="{StaticResource MutedForegroundBrush}">
            <StatusBarItem Content="{Binding StatusMessage}" />
            <Separator />
            <StatusBarItem Content="{Binding AutoRefreshStatus}" />
            <Separator />
            <StatusBarItem Content="{Binding SelectedQueue.Path, TargetNullValue=No queue selected}" />
        </StatusBar>
    </Grid>
</Window>
